{
  "name": "ClipBot",
  "build": {
    "dockerfile": "cloud/Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode"
    }
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "overrideCommand": true,
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "ClipBot"
    }
  },
  "postStartCommand": "python codespaces_start.py"
}
